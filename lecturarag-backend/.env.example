# ---------------------------------------------------------------------------
# LLM provider (any OpenAI-compatible /chat/completions endpoint)
# ---------------------------------------------------------------------------
# Leave LLM_API_KEY empty to run fully offline: the deterministic extractive
# engine still produces cited answers, flashcards and quizzes from your PDF.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# SQLite by default. Relative paths resolve from the directory you run from.
DATABASE_URL=sqlite:///./lecturarag.db

# ---------------------------------------------------------------------------
# HTTP / CORS
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=20

# ---------------------------------------------------------------------------
# Retrieval
# ---------------------------------------------------------------------------
CHUNK_SIZE=500
CHUNK_OVERLAP=100
RETRIEVAL_TOP_K=4
EMBEDDING_DIMENSIONS=512
